{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/rin00159/ripo-schema/refs/heads/main/schema/0.0.0/package.schema.json",
	"type": "object",
	"allOf": [{ "$ref": "https://www.schemastore.org/package.json" }],
	"properties": {
		"name": {
			"type": "string"
		},
		"version": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+$"
		},
		"description": {
			"type": "string"
		},
		"author": {
			"type": "string"
		},
		"license": {
			"type": "string"
		},
		"publishConfig": {
			"type": "object",
			"required": ["access"],
			"properties": {
				"access": {
					"type": "string"
				}
			}
		},
		"keywords": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string"
			}
		},
		"files": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"uniqueItems": true,
			"allOf": [{ "contains": { "const": "DIRDESC.yaml" } }]
		}
	},
	"required": [
		"name",
		"version",
		"description",
		"author",
		"license",
		"files",
		"publishConfig",
		"keywords"
	]
}
