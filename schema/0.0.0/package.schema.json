{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/rin00159/ripo-schema/refs/heads/main/schema/0.0.0/package.schema.json",
	"type": "object",
	"allOf": [{ "$ref": "https://www.schemastore.org/package.json" }],
	"properties": {
		"name": {
			"type": "string"
		},
		"version": {
			"type": "string",
			"description": "Semantic Versioning (SemVer 2.0.0) 形式のバージョン文字列。プレリリース（例: 1.0.0-beta.1）およびビルドメタデータに対応。",
			"pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
		},
		"description": {
			"type": "string"
		},
		"author": {
			"type": "string"
		},
		"license": {
			"type": "string"
		},
		"publishConfig": {
			"type": "object",
			"required": ["access"],
			"properties": {
				"access": {
					"type": "string"
				}
			}
		},
		"keywords": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string"
			}
		},
		"files": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"uniqueItems": true,
			"allOf": [{ "contains": { "const": "DIRDESC.yaml" } }]
		}
	},
	"required": [
		"name",
		"version",
		"description",
		"author",
		"license",
		"files",
		"publishConfig",
		"keywords"
	]
}
