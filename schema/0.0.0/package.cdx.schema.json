{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/rin00159/ripo-schema/refs/heads/main/schema/0.0.0/package.cdx.schema.json",
	"description": "schemaは`CycloneDX 1.6`を`ripo-schema`に基づいてさらに制約したschema",
	"$defs": {
		"issue": {
			"type": "object",
			"unevaluatedProperties": false,
			"properties": {
				"type": {},
				"id": {},
				"name": {},
				"description": {},
				"source": {
					"type": "object",
					"unevaluatedProperties": false,
					"properties": { "name": {}, "url": {} }
				}
			}
		}
	},
	"allOf": [
		{
			"$ref": "../vendor/bom-1.6.schema.json",
			"$comment": "`http://cyclonedx.org/schema/bom-1.6.schema.json`を使用したいところだが、vscodeのバリデーターではどうしても解決できなかった為"
		},
		{
			"type": "object",
			"unevaluatedProperties": false,
			"required": ["metadata"],
			"properties": {
				"$schema": {},
				"bomFormat": {},
				"specVersion": {},
				"metadata": {
					"type": "object",
					"required": ["component"],
					"unevaluatedProperties": false,
					"properties": {
						"component": {
							"type": "object",
							"unevaluatedProperties": false,
							"properties": {
								"type": {},
								"licenses": {
									"type": "array",
									"items": {
										"type": "object",
										"unevaluatedProperties": false,
										"properties": { "license": {} }
									}
								},
								"name": {}
							}
						}
					}
				},
				"components": {
					"type": "array",
					"items": {
						"type": "object",
						"unevaluatedProperties": false,
						"properties": {
							"type": {},
							"name": {},
							"licenses": {
								"type": "array",
								"items": {
									"type": "object",
									"unevaluatedProperties": false,
									"properties": {
										"license": {
											"type": "object",
											"unevaluatedProperties": false,
											"properties": {
												"id": {},
												"url": {}
											}
										}
									}
								}
							},
							"releaseNotes": {
								"type": "object",
								"unevaluatedProperties": false,
								"properties": {
									"type": {},
									"title": {},
									"description": {},
									"timestamp": {},
									"tags": {},
									"resolves": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
									"notes": {
										"type": "array",
										"items": {
											"type": "object",
											"unevaluatedProperties": false,
											"properties": {
												"locale": {},
												"text": {
													"type": "object",
													"unevaluatedProperties": false,
													"properties": { "contentType": {}, "content": {} }
												}
											}
										}
									}
								}
							},
							"pedigree": {
								"type": "object",
								"unevaluatedProperties": false,
								"properties": {
									"ancestors": {
										"type": "array",
										"items": {
											"type": "object",
											"unevaluatedProperties": false,
											"properties": {
												"bom-ref": {},
												"type": {},
												"name": {},
												"description": {},
												"copyright": {},
												"authors": {
													"type": "array",
													"items": {
														"type": "object",
														"unevaluatedProperties": false,
														"properties": {
															"name": {}
														}
													}
												},
												"licenses": {
													"type": "array",
													"items": {
														"type": "object",
														"unevaluatedProperties": false,
														"properties": {
															"license": {
																"type": "object",
																"unevaluatedProperties": false,
																"properties": {
																	"id": {},
																	"url": {}
																}
															}
														}
													}
												},
												"externalReferences": {
													"type": "array",
													"items": {
														"type": "object",
														"unevaluatedProperties": false,
														"properties": {
															"type": {},
															"url": {}
														}
													}
												}
											}
										}
									},
									"patches": {
										"type": "array",
										"items": {
											"type": "object",
											"unevaluatedProperties": false,
											"$comment": "変更の意味は resolves、機械可読な差分は diff。どちらか一方は必須(docs/package.md 参照)",
											"anyOf": [
												{ "required": ["diff"] },
												{
													"required": ["resolves"],
													"properties": { "resolves": { "minItems": 1 } }
												}
											],
											"properties": {
												"type": {},
												"diff": {
													"type": "object",
													"unevaluatedProperties": false,
													"properties": {
														"url": {},
														"text": {
															"type": "object",
															"unevaluatedProperties": false,
															"properties": {
																"contentType": {},
																"content": {}
															}
														}
													}
												},
												"resolves": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
											}
										}
									}
								}
							}
						}
					}
				},
				"definitions": {
					"type": "object",
					"unevaluatedProperties": false,
					"properties": {
						"standards": {
							"type": "array",
							"items": {
								"type": "object",
								"unevaluatedProperties": false,
								"properties": {
									"requirements": {
										"type": "array",
										"items": {
											"type": "object",
											"unevaluatedProperties": false,
											"required": ["title"],
											"properties": {
												"title": {}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	]
}
